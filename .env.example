# Server-side only. Never expose these as NEXT_PUBLIC_*.
OPENAI_API_KEY=your_api_key_here
# Required: random secret, at least 32 bytes; keep server-side only.
A1_SESSION_SECRET=replace_with_a_random_32_byte_or_longer_secret
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible provider endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Neon PostgreSQL connection string for the A1 backend.
# Use the Neon project/branch assigned to MyassistantA1.
DATABASE_URL=postgresql://...
NEXT_PUBLIC_API_BASE_URL=
